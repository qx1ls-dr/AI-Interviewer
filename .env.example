# Скопируйте в .env и заполните. Файл .env в git не попадает.

APP_ENV=development

# Базы данных: две раздельные БД (п. 4.8.1 ТЗ)
POSTGRES_USER=interviewer
POSTGRES_PASSWORD=interviewer
IDENTITY_DATABASE_URL=postgresql://interviewer:interviewer@localhost:5432/identity
ANALYTICS_DATABASE_URL=postgresql://interviewer:interviewer@localhost:5432/analytics
REDIS_URL=redis://localhost:6379/0

# Модель:
#   gigachat     — GigaChat API (бесплатный тариф для физлиц)
#   claude_code  — Claude по вашей подписке через Claude Code, только разработка
#                  и только синтетические данные (п. 4.5.3 ТЗ)
#   fake         — заглушка без сети
LLM_PROVIDER=gigachat

# --- GigaChat ---
# Ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Если не установлен сертификат Минцифры, на время разработки можно false
GIGACHAT_VERIFY_SSL=true

# --- Claude по подписке ---
# Нужен установленный Claude Code с входом в аккаунт Claude Pro/Max (команда claude).
# Модель: sonnet, opus и т.п.; пусто — модель по умолчанию в Claude Code.
CLAUDE_CODE_MODEL=

# Порог анонимности k по умолчанию
DEFAULT_K_THRESHOLD=5
