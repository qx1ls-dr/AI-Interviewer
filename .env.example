# Скопируйте в .env и заполните. Файл .env в git не попадает.

APP_ENV=development

# Базы данных: две раздельные БД (п. 4.8.1 ТЗ)
POSTGRES_USER=interviewer
POSTGRES_PASSWORD=interviewer
IDENTITY_DATABASE_URL=postgresql://interviewer:interviewer@localhost:5432/identity
ANALYTICS_DATABASE_URL=postgresql://interviewer:interviewer@localhost:5432/analytics
REDIS_URL=redis://localhost:6379/0

# Порог анонимности k по умолчанию
DEFAULT_K_THRESHOLD=5
