# Скопируйте в .env и заполните. Файл .env в git не попадает.

APP_ENV=development
# Режим разработки с MCP и подпиской Claude (п. 4.5.3 ТЗ).
# В эксплуатации обязательно false: MCP-сервер разработки не запускается.
DEV_MODE=true

# --- Базы данных (две раздельные БД, п. 4.8.1 ТЗ) ---
POSTGRES_USER=interviewer
POSTGRES_PASSWORD=interviewer
IDENTITY_DATABASE_URL=postgresql+psycopg://interviewer:interviewer@localhost:5432/identity
ANALYTICS_DATABASE_URL=postgresql+psycopg://interviewer:interviewer@localhost:5432/analytics
REDIS_URL=redis://localhost:6379/0

# --- Выбор модели (п. 4.5.2 ТЗ) ---
# claude | gigachat | yandexgpt | mcp_dev | fake
LLM_DEFAULT_PROVIDER=claude
# Переопределение по задачам: interview, moderation, pii, analysis, report (JSON).
# Задача pii не может идти в Claude: на неё приходит текст, где ещё могут быть ПДн.
LLM_TASK_PROVIDERS={"pii": "gigachat"}
LLM_TOKEN_LIMIT_PER_SURVEY=0
# Повторы запроса, если модель вернула JSON не по схеме (п. 4.1.2 ТЗ).
LLM_JSON_MAX_RETRIES=2

# --- Claude API ---
# В Claude уходят только обезличенные тексты (152-ФЗ, п. 4.8.1 ТЗ).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- GigaChat API ---
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# --- YandexGPT (Yandex AI Studio) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt

# Порог анонимности k по умолчанию.
DEFAULT_K_THRESHOLD=5
